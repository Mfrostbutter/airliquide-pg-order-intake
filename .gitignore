# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Customer data. Directory is tracked, contents are not.
# The lab schema, seed and synthetic fixtures are tracked (invented customers,
# .example domains). Anything from Air Liquide goes under data/fixtures/al/.
data/*
!data/.gitkeep
!data/README.md
!data/schema.sql
!data/seed.sql
!data/fixtures/
data/fixtures/al/

# Exports that may carry credential values
credentials*.json
*-credentials.json
exports/

# Credential id ledgers are instance-local. The workflow id map is tracked.
deploy/creds.*.json

# Scratch
.tmp/
*.log

# Personal Claude Code settings
.claude/settings.local.json
