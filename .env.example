# Engagement environment. Copy to .env and fill. NEVER commit .env.
#
# .mcp.json reads N8N_API_URL / N8N_API_KEY from the process environment, so
# export these before launching Claude Code in this directory:
#
#   set -a; . ./.env; set +a; claude
#
# The active pair points at the environment you are working against. Default to
# dev. Switch deliberately, and never point managed-mode MCP at prod without an
# explicit reason recorded in CLAUDE.md.

N8N_API_URL=
N8N_API_KEY=

# Per-environment values, kept for reference. Copy one pair into the active
# variables above when switching targets.
N8N_API_URL_DEV=
N8N_API_KEY_DEV=

N8N_API_URL_STAGING=
N8N_API_KEY_STAGING=

# Prod is intentionally blank by default. Promotion goes through the customer's
# agreed path, not an ad-hoc API write.
N8N_API_URL_PROD=
N8N_API_KEY_PROD=
