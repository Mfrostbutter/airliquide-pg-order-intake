            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "RespondInternalError",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "ShouldFail": {
      "main": [
        [
          {
            "node": "RespondServiceUnavailable",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "CreateSapSalesOrder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "CreateSapSalesOrder": {
      "main": [
        [
          {
            "node": "RespondCreated",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "RespondInternalError",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "saveDataSuccessExecution": "all",
    "saveDataErrorExecution": "all"
  },
  "tags": [
